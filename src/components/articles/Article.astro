---
import type { Page, Post } from '../../types'
interface Props {
  article: Page | Post;
}

const { article } = Astro.props;
import ArticleContentHtml from './ArticleContent.astro'
import ArticleHeader from './ArticleHeader.astro'
import ArticleAboutAdamFooter from './ArticleAboutAdamFooter.astro'

import { Comments } from '@/components/comments/Comments'
import PageFooter from '../PageFooter.astro'
import BackToTop from './BackToTop.astro'

// Only pass the fields the island needs — passing the whole article would
// serialize the full post content into the island's props, doubling the
// page weight on long posts.
const commentsArticle = {
  id: article.id,
  commentCount: 'commentCount' in article ? article.commentCount : 0,
  comments: 'comments' in article ? article.comments : [],
  allowComments: article.allowComments,
}
---


<article class="h-entry">
  <ArticleHeader article={article} />
  <ArticleContentHtml article={article} />
  <PageFooter>
    <ArticleAboutAdamFooter />
    <Comments article={commentsArticle} client:visible />
    <BackToTop />
  </PageFooter>
</article>