---
import "@fontsource-variable/inter";
import "@fontsource/pacifico";
import "@fontsource-variable/eb-garamond";

import "../styles/global.css";

const { title, description, image, ogType = 'website' } = Astro.props;
const generalSettings = {
	title: "Adam Fortuna's Blog",
}

const fullTitle = title ? `${title} | ${generalSettings.title}` : generalSettings.title;
const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url;
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{fullTitle}</title>
		{description && <meta name="description" content={description} />}
		<link rel="canonical" href={canonicalURL} />
		<link rel="icon" href="/favicon.ico" type="image/x-icon">
		<link rel="alternate" href="https://adamfortuna.com/feed" type="application/rss+xml" title="Adam Fortuna's Blog">
		<link rel="sitemap" href="/sitemap.xml" />
		<meta property="og:title" content={title || generalSettings.title} />
		{description && <meta property="og:description" content={description} />}
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={canonicalURL} />
		{image && <meta property="og:image" content={image} />}
		<meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
	</head>
	<body>
		<slot />
	</body>
</html>
