---
export const prerender = false

import Layout from "../layouts/Layout.astro"
import Article from "../components/articles/Article.astro";

import { getPostOrPageByUri } from '../lib/getPostOrPageByUri'

const uri = `/${Astro.params.uri}`;
const article = await getPostOrPageByUri(uri)

if(!article) {
  return new Response(null, {
    status: 404,
    statusText: 'Not Found',
  });
}

// The browser should always check freshness; edge caching is handled by
// the middleware (src/lib/edgeCache.ts).
Astro.response.headers.set("cache-control", "public, max-age=0, must-revalidate");
---

<Layout title={article.title} description={article.excerpt} image={article.featuredImage?.sourceUrl} ogType="article">
  <Article article={article} />
</Layout>
